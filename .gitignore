# ── Tunnel binaries ───────────────────────────────────────────────────────
# Kept on disk (run-tunnel*.cmd uses them) but never committed — ~90 MB.
# Download: https://ngrok.com/download · https://github.com/cloudflare/cloudflared/releases
ngrok.exe
cloudflared.exe
ngrok.yml

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Database ──────────────────────────────────────────────────────────────
# Local dev DB, created automatically on first backend start.
*.db
*.db-journal
*.sqlite3

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ── Capacitor / native builds ─────────────────────────────────────────────
# The native projects ARE committed; their build output and machine-specific
# config are not.
stratum-web-react/android/build/
stratum-web-react/android/app/build/
stratum-web-react/android/.gradle/
stratum-web-react/android/local.properties
stratum-web-react/android/app/src/main/assets/public/
stratum-web-react/ios/App/build/
stratum-web-react/ios/App/Pods/
stratum-web-react/ios/App/App/public/
*.apk
*.aab
*.keystore

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Generated analysis artifacts ──────────────────────────────────────────
graphify-out/

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Landing-page 3D model ─────────────────────────────────────────────────
# The car is a large binary that changes rarely and isn't source. Keep it out
# of history; see docs/CAR_MODEL.md for how to regenerate it.
stratum-web-react/public/car.glb
# Derived from car.glb by scripts/shrink-glb.py — rebuild it, don't commit it.
stratum-web-react/public/car-mobile.glb

# ── Cabin photographs ─────────────────────────────────────────────────────
# Manufacturer press imagery — kept out of the repo for the same reason as the
# car model: large binaries, and licensing that isn't ours to redistribute.
# See stratum-web-react/public/cabin/README.md.
stratum-web-react/public/cabin/*.jpg
stratum-web-react/public/cabin/*.jpeg
stratum-web-react/public/cabin/*.png
stratum-web-react/public/cabin/*.webp
