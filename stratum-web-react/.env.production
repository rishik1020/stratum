# Absolute backend URL used by the NATIVE (APK) build and any production web build.
# The APK has no Vite dev-proxy, so it must reach the backend directly.
#
# Point this at your backend (FastAPI on :8000), exposed over HTTPS. With the
# ngrok stable domain repurposed to the backend (see run-tunnel-backend.cmd):
VITE_API_BASE_URL=https://autism-henna-sanitary.ngrok-free.dev

# --- Alternatives ---
# Same-WiFi LAN (cleartext; allowMixedContent + usesCleartextTraffic enabled):
#   VITE_API_BASE_URL=http://192.168.1.50:8000
# Deployed backend:
#   VITE_API_BASE_URL=https://api.stratum.example.com
