# Backend URL baked into the build at compile time.
#
# This is what the APK/IPA and any production web build talk to — there is no
# Vite dev-proxy outside `npm run dev`, so the app needs an absolute URL.
#
# ⚠ RIGHT NOW THIS POINTS AT A PERSONAL NGROK DEV TUNNEL.
#   That's fine for testing an APK on your own phone, but it means every build
#   you hand to anyone else only works while your PC is on and the tunnel is up.
#   For a release, deploy the backend (see docs/DEPLOY.md) and change the line
#   below to the permanent URL — then rebuild the APK.
#
#   Whatever you set here must match the domain in run-tunnel-backend.cmd.

VITE_API_BASE_URL=https://autism-henna-sanitary.ngrok-free.dev

# --- Alternatives ---
# Deployed backend (what a real release should use):
#   VITE_API_BASE_URL=https://stratum-api.onrender.com
# Same-WiFi LAN (cleartext; allowMixedContent + usesCleartextTraffic enabled):
#   VITE_API_BASE_URL=http://192.168.1.50:8000
