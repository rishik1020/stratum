<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            The foreground service that keeps a drive recording once the screen
            goes off is declared by @capacitor-community/background-geolocation
            and merged in from its own manifest — do not redeclare it here. A
            second <service> entry that disagrees on android:exported fails the
            manifest merge outright.
        -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location: precise GPS for live telemetry & drive scoring. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Recording with the screen off is handled by a foreground service of type
        "location" (declared by the plugin). While that service runs Android
        counts the app as in-use, so ordinary "while using the app" location is
        enough and ACCESS_BACKGROUND_LOCATION is deliberately NOT requested — it
        would add a second, harder "Allow all the time" prompt and a Play Store
        policy declaration for a capability this app doesn't need.

        FOREGROUND_SERVICE / FOREGROUND_SERVICE_LOCATION (Android 14+) and
        POST_NOTIFICATIONS (Android 13+, for the ongoing recording notification)
        also arrive via the plugin's manifest.
    -->
    <!-- Motion sensors (accelerometer/gyroscope) need no runtime permission. -->

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
